<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0a0a14" />
        </shape>
    </item>
    <item
        android:width="200dp"
        android:height="4dp"
        android:gravity="center_horizontal|top"
        android:top="120dp">
        <shape android:shape="rectangle">
            <solid android:color="#cc8844" />
        </shape>
    </item>
    <item
        android:width="120dp"
        android:height="4dp"
        android:gravity="center_horizontal|top"
        android:top="130dp">
        <shape android:shape="rectangle">
            <solid android:color="#ffcc00" />
        </shape>
    </item>
    <item
        android:width="80dp"
        android:height="4dp"
        android:gravity="center_horizontal|top"
        android:top="140dp">
        <shape android:shape="rectangle">
            <solid android:color="#cc4444" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:top="180dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LCARS"
            android:textColor="#cc8844"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </item>
</layer-list>
