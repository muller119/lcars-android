<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#0a0a14">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LCARS Dashboard Instellingen"
        android:textColor="#cc8844"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard URL:"
        android:textColor="#ffcc00"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/urlInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1a1a2e"
        android:textColor="#ffffff"
        android:textColorHint="#666666"
        android:hint="http://192.168.1.49:8123/local/lcars-dashboard.html"
        android:padding="12dp"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:inputType="textUri"
        android:singleLine="true"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:background="#cc6622"
        android:text="OPSLAAN"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="48dp" />

    <!-- Update sectie -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333355"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UPDATE"
        android:textColor="#4488cc"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/versionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Huidige versie: 1.0.0"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/updateStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#ffcc00"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/checkUpdateButton"
        android:layout_width="250dp"
        android:layout_height="48dp"
        android:background="#4488cc"
        android:text="CHECK OP UPDATES"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

</LinearLayout>
